# Application
APP_NAME=simple-ocr-service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Auth
API_KEYS=dev-secret-key-1,dev-secret-key-2

# CORS
CORS_ORIGINS=*

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Tesseract (OCR engine)
# Path to the `tesseract` binary. Uncomment to override (default uses PATH lookup).
# TESSERACT_CMD=/usr/bin/tesseract
# Default OCR language (BCP-47 / ISO 639-2): eng, hin, fra, deu, spa ...
TESSERACT_LANG=eng
# Optional OEM/PSM modes (leave blank for Tesseract defaults)
TESSERACT_OEM=
TESSERACT_PSM=

# OCR cache (LRU + optional TTL). Identical image bytes + language skip Tesseract.
OCR_CACHE_ENABLED=true
OCR_CACHE_CAPACITY=128
OCR_CACHE_TTL_SECONDS=0
# Dedicated audit log for cache hit/miss (always-on, independent of LOG_LEVEL).
OCR_CACHE_AUDIT_LOG=logs/ocr_cache.log

# Database (async URL used by the app; sync URL used by migrations/tools)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ocr
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/ocr
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
